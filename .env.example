# =============================================================================
# Credit Card Fraud Detection — Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values.
# All variables are optional and override config.yaml settings.

# Logging
LOG_LEVEL=INFO

# MLflow
MLFLOW_TRACKING_URI=mlruns
MLFLOW_EXPERIMENT_NAME=credit-fraud-detection

# FastAPI
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=1

# Model
DEFAULT_MODEL=xgboost

# Optimization
OPTUNA_N_TRIALS=50
CV_FOLDS=5

# Threshold
THRESHOLD_STRATEGY=f1
COST_FP=1.0
COST_FN=10.0
